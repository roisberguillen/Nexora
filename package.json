{
  "name": "nexora",
  "private": true,
  "version": "0.5.0-rc.1",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @nexora/web run dev",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "doctor": "node scripts/doctor.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "manifest:update": "node scripts/project-manifest.mjs --write",
    "manifest:check": "node scripts/project-manifest.mjs --check",
    "codex:validate": "node scripts/codex-orchestrator.mjs validate",
    "codex:route": "node scripts/codex-orchestrator.mjs route",
    "codex:status": "node scripts/codex-orchestrator.mjs status",
    "codex:checkpoint": "node scripts/codex-orchestrator.mjs checkpoint",
    "codex:next": "node scripts/codex-orchestrator.mjs next",
    "codex:can-advance": "node scripts/codex-orchestrator.mjs can-advance",
    "codex:autopilot-status": "node scripts/codex-orchestrator.mjs autopilot-status",
    "codex:finalize": "node scripts/codex-finalize.mjs",
    "android:configure-signing": "node scripts/configure-android-signing.mjs",
    "codex:test": "node --test scripts/codex-orchestrator.test.mjs",
    "quality:ui-ux": "node scripts/validate-ui-ux-review.mjs",
    "test:ui-ux": "node --test scripts/validate-ui-ux-review.test.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
