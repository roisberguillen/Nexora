{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexora Backup Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "schemaVersion",
    "createdAt",
    "files"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "const": "database.sqlite3"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 100,
            "maximum": 536870912
          }
        }
      }
    }
  }
}
